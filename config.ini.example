; ============================================================
; SECURITY NOTE: this file stores your SQL Server login in
; PLAIN TEXT. This is a development/testing design choice for
; this project right now -- a production deployment would very
; likely need a different, more secure credential storage
; approach (a secrets manager, OS keychain, etc.), and this
; format is NOT guaranteed to be how production configuration
; works if/when that's designed. Keep this file private, and
; never share it or commit a filled-in copy anywhere.
; ============================================================
[SqlServer]
Host=localhost
Port=1433
; Leave User/Password as the placeholders below (or blank) to
; keep using Windows Integrated Authentication (the default
; when this file is absent or these fields aren't filled in).
; Fill both in only if you want SQL Server Authentication
; instead (required on platforms without Windows/Kerberos).
User=your_user_here
Password=your_password_here
PoolSize=16
