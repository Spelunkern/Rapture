# Build output
build/
out/

# Local SQL Server credentials and legacy data (tools/sqlserver.py)
.local/

# IDE/editor cruft
.vs/
*.user
*.suo

# Runtime/log artifacts (recreated automatically on next start)
logs/*.log
runtime/sessions/
runtime/*.bin

# Original Shaiya map data (proprietary game data, not project source --
# see data/maps/README.txt for where to place your own copies)
data/maps/*.svmap
data/game/*
!data/game/README.txt

# Personal/session-continuity notes, not part of the public project
NEXT_SESSION.txt
RAPTURE_PROGRESS_LOG.txt
RAPTURE_SESSION_GUIDE.txt
RAPTURE_ROADMAP.md

# Vendored third-party reference tool (excluded: has its own git history/
# license, not part of Rapture itself)
tools/refs/

# Claude Code local session/agent state -- machine-specific, not project
# source.
.claude/
