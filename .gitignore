# Build output
target/
build/
out/

# IDE/editor cruft
.vs/
*.user
*.suo

# Runtime/log artifacts (recreated automatically on next start)
logs/*.log
runtime/sessions/
runtime/*.bin

# Original Shaiya map data (proprietary game data, not project source --
# see data/maps/README.txt for where to place your own copies)
data/maps/*.svmap

# Personal/session-continuity notes, not part of the public project
NEXT_SESSION.txt
RAPTURE_PROGRESS_LOG.txt
RAPTURE_SESSION_GUIDE.txt
RAPTURE_ROADMAP.md

# Vendored third-party reference tool (excluded: has its own git history/
# license, not part of Rapture itself)
tools/refs/

# Generated local secrets for the MariaDB/SQL Server dev containers --
# never commit, regenerate per machine (see docker/README.md once written)
docker/mariadb/*_password.txt
docker/mssql/*_password.txt

# Real local config -- may contain a filled-in SQL Server login. Copy
# config.ini.example (tracked, placeholders only) to config.ini and fill it
# in; config.ini itself must never be committed.
config.ini
